        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "avg(container_memory_working_set_bytes{namespace=\"arc-runners\", container=\"runner\"})",
