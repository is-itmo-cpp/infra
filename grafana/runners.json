        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "avg(rate(container_cpu_usage_seconds_total{namespace=\"arc-runners\", container=\"runner\"}[$__rate_interval]))",
          "legendFormat": "avg"
        }
      ],
      "description": "Distribution across all runner pods. Red line = the 1 core request. CPU has no limit, so pods exceed it when the node has spare cores; an average well below 1 means more runners per core would fit.",
