            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gha_job_startup_duration_seconds_bucket[1h])))",
          "legendFormat": ""
        }
      ],
      "description": "Time from a job being assigned to a node until a runner picks it up. Excludes time queued at GitHub while all nodes were full.",
      "id": 4
    },
